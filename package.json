{
  "name": "@agntn/maps",
  "version": "0.0.0",
  "description": "Unified geocoding and maps provider library for humans and agents",
  "keywords": [
    "omp-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/agntn/maps#readme",
  "bugs": "https://github.com/agntn/maps/issues",
  "license": "MIT",
  "author": "oritwoen (https://github.com/oritwoen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agntn/maps.git"
  },
  "bin": {
    "maps": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "packages/omp/extensions",
    "packages/pi/extensions"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai.d.mts",
      "import": "./dist/ai.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev": "obuild --stub",
    "fmt": "pnpm build && vp lint --fix && vp fmt",
    "lint": "pnpm build && vp lint && vp fmt --check",
    "typecheck": "tsc --noEmit && pnpm build && tsc --noEmit -p tsconfig.extensions.json",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:cli": "pnpm build && node test/eval-cli.mjs",
    "test:mcp": "pnpm build && node test/eval-mcp.mjs",
    "test:packed": "node test/eval-packed.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@agntn/tools": "catalog:deps",
    "@modelcontextprotocol/server": "catalog:deps"
  },
  "devDependencies": {
    "@agntn/ox": "catalog:dev",
    "@earendil-works/pi-coding-agent": "catalog:dev",
    "@modelcontextprotocol/client": "catalog:dev",
    "@oh-my-pi/pi-coding-agent": "catalog:dev",
    "@types/node": "catalog:dev",
    "ai": "catalog:dev",
    "obuild": "catalog:dev",
    "typescript": "catalog:dev",
    "vite-plus": "catalog:dev"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2 <2",
    "@oh-my-pi/pi-coding-agent": ">=18.0.0 <19",
    "ai": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0",
  "omp": {
    "extensions": [
      "./packages/omp/extensions/maps.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./packages/pi/extensions/maps.ts"
    ]
  }
}
